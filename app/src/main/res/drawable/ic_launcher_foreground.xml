<?xml version="1.0" encoding="utf-8"?>
<!-- A lowercase "f", drawn as a single bold monoline stroke - not a plain letterform: the hook at
     the top is drawn deliberately open and rounded so its silhouette reads as a coat-hanger hook,
     tying the mark to the wardrobe domain the way a single-letter mark should (cf. Pinterest's
     "P" reading as a pin). Centered within the adaptive icon's 66dp safe zone (a circle of that
     diameter centered on the 108dp canvas survives every launcher mask shape). Also used as-is
     for the monochrome variant - the system applies its own single-color tint to this shape. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M63,30 C50,25 41,32 45,43 L45,78"
        android:strokeWidth="13"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="52"
                android:startY="25"
                android:endX="52"
                android:endY="78"
                android:type="linear">
                <item android:color="#FFFFFF" android:offset="0.0" />
                <item android:color="#FFF3EC" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M34,50L58,50"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="13"
        android:strokeLineCap="round" />
</vector>
