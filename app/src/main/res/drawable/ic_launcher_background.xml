<?xml version="1.0" encoding="utf-8"?>
<!-- Diagonal gradient across the same terracotta family as the app's primary (Color.kt's P48
     #BA532E, from the seed in ADR 0007) - a lighter coral tone at the top-left down to a deep
     burnt-sienna at the bottom-right, for a sense of light and depth instead of one flat fill.
     Regenerate alongside the palette rather than hand-picking different endpoints. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="8"
                android:startY="8"
                android:endX="100"
                android:endY="100"
                android:type="linear">
                <item android:color="#D6795A" android:offset="0.0" />
                <item android:color="#BA532E" android:offset="0.5" />
                <item android:color="#8B3C1E" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
