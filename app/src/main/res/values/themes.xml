<resources>
    <!--
      Only paints the window before Compose takes over; the colours the app actually uses live in
      Color.kt. Kept in sync with the light scheme's surface/primary so the launch does not flash a
      different colour than the first frame.
    -->
    <style name="Theme.Fitly" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/fitly_surface</item>
        <item name="colorPrimary">@color/fitly_primary</item>
    </style>
</resources>
